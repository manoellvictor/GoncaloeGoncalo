# Copie para .env.local e preencha.
#
# Todas as variáveis NEXT_PUBLIC_* vão para o browser — nunca coloque segredos
# aqui. A proteção dos dados vem do RLS no Supabase, não do sigilo da chave.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave secreta (service role): NÃO é usada pelo projeto. O painel /admin grava
# com a sessão da conta do escritório, respeitando as regras do banco. Deixe
# vazia; se um dia for necessária, nunca use o prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do site (usada em canonical, OpenGraph e sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Segredo do cron de artigos agendados (/api/cron/agendados). Gere um valor
# aleatório longo; a Vercel envia "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=


# Contato do escritório e redes sociais NÃO ficam aqui: edite src/lib/site-config.ts.
