# Copie para .env.local e preencha.
#
# Todas as variáveis NEXT_PUBLIC_* vão para o browser — nunca coloque segredos
# aqui. A proteção dos dados vem do RLS no Supabase, não do sigilo da chave.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública do site (usada em canonical, OpenGraph e sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Contato do escritório ---
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_EMAIL=
NEXT_PUBLIC_ADDRESS=
NEXT_PUBLIC_ADDRESS_CITY=
NEXT_PUBLIC_ADDRESS_ZIP=
# Número do WhatsApp com código do país, só dígitos (ex.: 5511999999999)
NEXT_PUBLIC_WHATSAPP=
# Endereço como aparece na busca do Google Maps
NEXT_PUBLIC_MAPS_QUERY=

# --- Redes sociais ---
NEXT_PUBLIC_LINKEDIN=
NEXT_PUBLIC_INSTAGRAM=
NEXT_PUBLIC_YOUTUBE=
